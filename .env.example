# Локальная конфигурация сборки и загрузки через cmd.
# Скопируйте файл в .env и задайте пути своего окружения.
# Формат: ИМЯ=значение, без set/export и подстановок переменных.

SYSTEM=windows
PROGRAM_NAME=ImuReading
# Каталог результатов относительно корня проекта, без пробелов.
BUILD_DIR=Debug_Win
MAKE_COMMAND=make
GCC_PLACE=C:/SysGCC/arm-eabi

OPENOCD_EXE=C:/tool-openocd/bin/openocd.exe
OPENOCD_SCRIPTS_DIR=C:/tool-openocd/scripts
OPENOCD_CONFIG=stm32f3discovery.cfg
